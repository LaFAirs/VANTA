    "vanta.error.reason.invalidURL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid URL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist keine gültige URL."
          }
        }
      }
    },
    "vanta.error.reason.insecureURL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses plain HTTP. Use HTTPS or confirm explicitly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nutzt unverschlüsseltes HTTP. Nutze HTTPS oder bestätige ausdrücklich."
          }
        }
      }
    },
    "vanta.error.reason.ipaNotFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The IPA file could not be located."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die IPA-Datei wurde nicht gefunden."
          }
        }
      }
    },
    "vanta.error.reason.infoPlistMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Info.plist was found inside Payload/*.app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Info.plist in Payload/*.app gefunden."
          }
        }
      }
    },
    "vanta.error.reason.unsupportedArchitecture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Architecture “%@” is not supported on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Architektur „%@“ wird auf diesem Gerät nicht unterstützt."
          }
        }
      }
    },
    "vanta.error.reason.certificateExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” expired on %@. Import a current identity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist am %@ abgelaufen. Importiere eine aktuelle Identität."
          }
        }
      }
    },
    "vanta.error.reason.profileExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” expired on %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist am %@ abgelaufen."
          }
        }
      }
    },
    "vanta.error.reason.profileMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected provisioning profile does not match this Bundle Identifier.\nBundle ID: %@\nProvisioning Profile: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gewählte Provisioning-Profil passt nicht zu dieser Bundle-ID.\nBundle-ID: %@\nProvisioning-Profil: %@"
          }
        }
      }
    },
    "vanta.error.reason.entitlementsMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing entitlements: %@. Choose a profile that grants them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Entitlements: %@. Wähle ein Profil, das sie enthält."
          }
        }
      }
    },
    "vanta.error.remedy.profileMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another profile"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anderes Profil wählen"
          }
        }
      }
    },
    "vanta.error.remedy.insecureURL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use HTTPS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS nutzen"
          }
        }
      }
    },
    "vanta.error.remedy.expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace certificate"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikat ersetzen"
          }
        }
      }
    },
    "vanta.error.remedy.requirements": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View requirements"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voraussetzungen ansehen"
          }
        }
      }
    },
    "vanta.error.remedy.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        }
      }
    }
  },
  "version": "1.0.0"
